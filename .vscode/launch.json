{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: run server (press F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver"],
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Django: run tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test", "-v", "2"],
      "django": true,
      "justMyCode": true
    }
  ]
}
