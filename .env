# Copy this file to .env and edit it. Never commit .env to GitHub.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use SQLite (zero setup).
# For PostgreSQL, uncomment and edit:
# DATABASE_URL=postgresql://sms_user:sms_password@localhost:5432/sms_db
